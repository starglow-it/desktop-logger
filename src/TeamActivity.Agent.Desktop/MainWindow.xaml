<Window x:Class="TeamActivity.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeamActivity" Width="780" Height="590" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="28,22">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="TeamActivity" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Your transparent workplace activity record" Foreground="#CBD5E1" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="14" Padding="14,7" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TrackingStatus}" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Border Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Work session" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Activity telemetry counts input events but never records which key or mouse button you use. It does not measure work quality."
                                   TextWrapping="Wrap" Foreground="#475569" Margin="0,8,0,18" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start work" Command="{Binding StartWorkCommand}" />
                            <Button Content="Start break" Command="{Binding StartBreakCommand}" />
                            <Button Content="End break" Command="{Binding EndBreakCommand}" />
                            <Button Content="End work" Command="{Binding EndWorkCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Last synchronization" Foreground="#64748B" />
                            <TextBlock Text="{Binding LastSynchronization}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Last screenshot" Foreground="#64748B" />
                            <TextBlock Text="Not enabled in this release" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Current policy summary" FontSize="17" FontWeight="SemiBold" Foreground="#1E3A8A" />
                        <TextBlock Text="• 60-second aggregate activity buckets&#x0a;• Five-minute idle threshold&#x0a;• Screenshot capture disabled in v0.1&#x0a;• Remote support disabled in v0.1&#x0a;• No raw keys, clipboard contents, microphone, or covert processes"
                                   TextWrapping="Wrap" LineHeight="24" Foreground="#1E40AF" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="28,12">
            <TextBlock Text="The tray icon remains visible while TeamActivity is running. Contact your administrator for privacy, retention, correction, or uninstall requests."
                       Foreground="#64748B" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
